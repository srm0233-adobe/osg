            ".caro.wide.feature.caps-feature"
          ]
        },
        {
          "name": "columns-media",
          "instances": [
            "section.wrapper.home-video-promo.clearfix",
            "section.wrapper.buy-issue"
          ]
        },
        {
          "name": "cards-video",
          "instances": [
            ".row.flex-grid.video-grid"
          ]
        },
        {
          "name": "cards-covers",
