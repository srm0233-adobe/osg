        {
          "name": "video-embed",
          "instances": [
            ".home-sidebar-video .is-fixed"
          ]
        },
        {
          "name": "cards-articles",
          "instances": [
            ".grid.default-grid.four-wide.latest-articles"
          ]
        },
        {
          "name": "carousel-shows",
